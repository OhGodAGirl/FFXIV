      "mutator": "Arithmetic mutation",
      "replacement": "-(max + min) * 2",
      "startLine": 19,
      "startColumn": 25,
      "endLine": 19,
      "endColumn": 41,
      "rationale": "Lightness is used only as a sort key. Replacing division by 2 with multiplication by 2 scales every key by positive 4. Values lie in [-4,0], with no overflow or underflow; ordering and ties are unchanged.",
      "reviewer": "portfolio_style_review"
    },
    {
      "path": "src/Features/Main/DyePaletteOrder.cs",
      "sourceSha256": "47EB599C8B13169A6AE67EC6391067CB1F7D6550863B206BA28DC64B8CB84F62",
      "mutator": "Equality mutation",
      "replacement": "delta <= 0.08f",
      "startLine": 20,
      "startColumn": 13,
      "endLine": 20,
      "endColumn": 26,
      "rationale": "Each normalized channel is a byte divided by255. Delta differences nearest0.08 are20/255 and21/255, separated by much more than float rounding. Delta cannot equal0.08f, so strict vs inclusive comparison gives the same result.",
      "reviewer": "portfolio_style_review"
    },
