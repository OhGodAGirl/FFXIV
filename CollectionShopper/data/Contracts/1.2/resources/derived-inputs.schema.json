{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exportaramus.local/schemas/ffxiv-collect/1.0/derived-inputs.schema.json",
  "title": "Exportaramus FFXIV Collect Derived Inputs 1.0",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "upstreamRepository",
    "upstreamCommit",
    "verifiedAtUtc",
    "validatedGameDataVersion",
    "relationshipHashes",
    "outfits",
    "relics"
  ],
  "properties": {
    "format": { "type": "string", "const": "exportaramus-ffxiv-collect-derived-inputs" },
    "schemaVersion": { "type": "string", "const": "1.0" },
    "upstreamRepository": { "type": "string", "const": "https://github.com/skyborn-industries/ffxiv-collect" },
    "upstreamCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "verifiedAtUtc": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
    "validatedGameDataVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "relationshipHashes": {
      "type": "object",
      "required": ["outfitsSha256", "relicsSha256"],
      "properties": {
        "outfitsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "relicsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "outfits": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": ["id", "requiredItemIds"],
        "properties": {
          "id": { "$ref": "#/$defs/positiveId" },
          "requiredItemIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/positiveId" }
          }
        },
        "additionalProperties": false
      }
    },
    "relics": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": ["id", "achievementId"],
        "properties": {
          "id": { "$ref": "#/$defs/positiveId" },
          "achievementId": {
            "oneOf": [
              { "$ref": "#/$defs/positiveId" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "positiveId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    }
  },
  "additionalProperties": false
}
