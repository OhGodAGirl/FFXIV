{
  "stryker-config": {
    "project": "Exportaramus.ConsumerKit.V1_2.csproj",
    "test-projects": [
      "../../../tests/Exportaramus.ConsumerKit.Tests/Exportaramus.ConsumerKit.Tests.csproj"
    ],
    "configuration": "Release",
    "mutate": [
      "**/*"
    ],
    "mutation-level": "Standard",
    "concurrency": 4,
    "coverage-analysis": "perTestInIsolation",
    "disable-mix-mutants": true,
    "additional-timeout": 30000,
    "reporters": [
      "Json",
      "Html",
      "Progress"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    }
  }
}
