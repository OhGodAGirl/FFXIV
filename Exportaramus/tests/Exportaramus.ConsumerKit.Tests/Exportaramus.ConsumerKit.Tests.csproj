<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <ConsumerKitRoot Condition="'$(ConsumerKitRoot)' == ''">../..</ConsumerKitRoot>
    <ConsumerKitProject Condition="'$(ConsumerKitProject)' == ''">$(ConsumerKitRoot)/project/ConsumerKit/1.2/Exportaramus.ConsumerKit.V1_2.csproj</ConsumerKitProject>
    <ConsumerKitFixtures Condition="'$(ConsumerKitFixtures)' == ''">$(MSBuildThisFileDirectory)fixtures</ConsumerKitFixtures>
    <InventoryReaderSource Condition="'$(InventoryReaderSource)' == ''">../../examples/CollectionExample/InventoryItemReader.cs</InventoryReaderSource>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <ProjectReference Include="$(ConsumerKitProject)" />
    <Compile Include="$(InventoryReaderSource)" Link="Example/InventoryItemReader.cs" />
    <Content Include="$(ConsumerKitFixtures)/valid/*.json" Link="fixtures/valid/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ConsumerKitFixtures)/invalid/*.json" Link="fixtures/invalid/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
