root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

[*.{csproj,props,targets,slnx,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_prefer_braces = true:suggestion

# Pinned vendor sources remain byte-for-byte unchanged. Formatting commands exclude src/Contracts/.
[src/Contracts/**]
indent_style = unset
indent_size = unset
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
csharp_new_line_before_open_brace = unset
csharp_style_namespace_declarations = file_scoped:none
csharp_prefer_braces = true:none
csharp_style_var_for_built_in_types = false:none
csharp_style_var_when_type_is_apparent = false:none
csharp_style_var_elsewhere = false:none
dotnet_sort_system_directives_first = unset
dotnet_separate_import_directive_groups = unset
